# SQLite provides an optional local development mode; production uses PostgreSQL.
LOTTOLAB_DATABASE_URL=sqlite:///./.local/lottolab.db
LOTTOLAB_DATA_DIR=.local
# Enable only when the development API binds to 127.0.0.1.
LOTTOLAB_ALLOW_LOCAL_WRITES=true
# Set a strong token and disable local writes for non-local deployments.
LOTTOLAB_ADMIN_TOKEN=
LOTTOLAB_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
LOTTOLAB_ALLOWED_HOSTS=localhost,127.0.0.1
# Docker Compose requires an explicit password; never commit the populated .env.
POSTGRES_PASSWORD=
