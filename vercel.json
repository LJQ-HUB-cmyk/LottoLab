{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "regions": ["iad1"],
  "functions": {
    "app.py": {
      "maxDuration": 300,
      "excludeFiles": "{.local/**,.venv/**,.devtools/**,.env*,docs/**,tests/**,frontend/node_modules/**,frontend/e2e/**,frontend/test-results/**,frontend/playwright-report/**,**/__pycache__/**,**/*.zip}"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=31536000, immutable"},
        {"key": "X-Content-Type-Options", "value": "nosniff"}
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [{"key": "Cache-Control", "value": "no-store"}]
    }
  ]
}
